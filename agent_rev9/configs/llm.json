{
  "enabled": true,
  "provider": "dacon",
  "api_type": "responses",
  "base_url": "https://dacon-apim-hackathon-0903.azure-api.net/hackathon/openai/v1",
  "endpoint": "/responses",
  "auth_header": "api-key",
  "default_model": "gpt-5.6-sol",
  "available_models": [
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna"
  ],
  "timeout_seconds": 45,
  "max_output_tokens": 1800,
  "api_key_env": "DACON_API_KEY"
}
